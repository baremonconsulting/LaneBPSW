    given-names: "Jan"
    affiliation: "Baremon s.r.o."
repository-code: "https://github.com/baremonconsulting/LaneBPSW"
license: Apache-2.0
keywords:
  - Baillie–PSW test
  - prime generation
  - AVX-512 IFMA
  - Montgomery multiplication
  - GMP
  - chiavdf
